# Knova backend environment. Copy to backend/.env and fill in real values.
# Never commit the real .env — only this template. No secrets belong in this file.

DEBUG=true

# Postgres (asyncpg). Use the DIRECT (non-pooler) URL for migrations/seeding.
DATABASE_URL=postgresql://postgres:password@localhost:5432/knova
REDIS_URL=

SECRET_KEY=change-me-to-a-random-48-char-secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_MINUTES=1440


ALLOW_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# --- Recommendation ---
# Serve ranker features from live per-user telemetry (off => frozen training medians).
LIVE_FEATURES_ENABLED=true

# --- LLM providers (content / quiz generation) ---
# Google is primary, OpenRouter is the fallback;
GOOGLE_API_KEY=
GOOGLE_GENAI_MODEL=gemini-2.5-flash
GOOGLE_GENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta

OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_APP_URL=https://knova.app
OPENROUTER_APP_TITLE=Knova

LLM_TIMEOUT_SECONDS=60
LLM_MAX_ATTEMPTS=2
LLM_TEMPERATURE=0.7

# --- Quiz generation ---
QUIZ_AUTOGEN_ENABLED=true
QUIZ_MCQ_PER_TOPIC=5
QUIZ_MCQ_MAX_PER_REQUEST=20
QUIZ_BOT_EMAIL=quizbot@knova.internal
QUIZ_BOT_USERNAME=Knova Quiz Bot

